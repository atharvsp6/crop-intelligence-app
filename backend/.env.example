# Azure Environment Variables Template for Backend
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit .env files with real credentials to git!

# MongoDB Connection (Use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority&appName=cropintelligence

# Google Gemini API Key (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Port (Azure sets this automatically, use 5000 for local development)
PORT=5000

# Essential APIs for Indian Agricultural Data
OPENWEATHER_API_KEY=your_openweather_api_key_here
DATA_GOV_IN_API_KEY=your_govt_mandi_prices_api_key_here

# Real-time Market Intelligence APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
COMMODITIES_API_KEY=your_commodities_api_key_here
QUANDL_API_KEY=your_quandl_api_key_here
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Authentication Configuration
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-this
JWT_EXPIRY_HOURS=24

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=0

# =============================================================================
# CORS Configuration - Critical for seamless backend switching
# =============================================================================
# FRONTEND_URL: Your primary frontend deployment URL
FRONTEND_URL=https://your-frontend-app.vercel.app

# ALLOWED_ORIGINS: Comma-separated list of additional allowed origins
# The backend automatically allows:
#   - All *.vercel.app domains (Vercel deployments)
#   - All *.azurewebsites.net domains (Azure deployments)
#   - All *.onrender.com domains (Render deployments)
#   - localhost:3000, localhost:3001 (local development)
# 
# Add any custom domains here:
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,https://custom-domain.com

# VERCEL_PREVIEW_ORIGINS: Comma-separated Vercel preview deployment URLs (optional)
VERCEL_PREVIEW_ORIGINS=https://crop-intelligence-app-git-feature-xyz.vercel.app

# Disease Detection Service
DISEASE_SERVICE_URL=https://plant-disease-detection-api-nni5.onrender.com/predict
DISEASE_SERVICE_TIMEOUT=30

# TensorFlow Hub Cache (Azure specific path)
TFHUB_CACHE_DIR=/home/site/wwwroot/.tfhub_cache
