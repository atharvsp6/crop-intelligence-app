# Environment
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "*"]

# Firebase Configuration (leave empty for mock mode in development)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS_PATH=
# For cloud deployments, use JSON string:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# AI Services
DISEASE_SERVICE_URL=http://localhost:8001
YIELD_SERVICE_URL=http://localhost:8002
AI_SERVICE_TIMEOUT=30

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Caching
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Weather API (OpenWeatherMap - free tier)
# Get your free API key at: https://openweathermap.org/api
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Market Data
MARKET_DATA_CACHE_TTL=3600

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Background Tasks (optional - Redis required)
REDIS_URL=
USE_BACKGROUND_TASKS=false
