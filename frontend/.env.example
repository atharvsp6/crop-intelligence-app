# React Frontend Environment Variables Template
# Copy this to .env and fill in your actual values
# For Azure Static Web Apps, these must be prefixed with REACT_APP_

# Backend API URL (Your Azure App Service backend URL)
REACT_APP_API_BASE=https://your-backend-app.azurewebsites.net

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/
# Steps:
# 1. Create a new project in Google Cloud Console
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Credential (Web application)
# 4. Add authorized redirect URIs: http://localhost:3000, https://your-frontend-domain.com
# 5. Copy the Client ID and paste it below
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here

# Mapbox Token (Get from https://www.mapbox.com/)
REACT_APP_MAPBOX_TOKEN=your-mapbox-token-here

# Optional: Other API keys
# REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-key
