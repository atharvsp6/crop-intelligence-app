# Frontend Environment Variables for Production
# These are configured in Vercel Dashboard → Settings → Environment Variables

# =============================================================================
# Backend API URL - Update this to switch between backends
# =============================================================================
# Current: Azure App Service
# To switch to Render, change to: https://your-service-name.onrender.com
# To switch to another Azure instance, change to: https://new-instance.azurewebsites.net
REACT_APP_API_BASE=https://crop-intelligence-api.azurewebsites.net

# =============================================================================
# Google OAuth Client ID
# =============================================================================
# This Client ID is configured in Google Cloud Console
# Authorized JavaScript origins include:
# - https://crop-intelligence-app.vercel.app
# - https://yieldwise.vercel.app
# - http://localhost:3000
REACT_APP_GOOGLE_CLIENT_ID=256903778855-3mn5f57aet7nia5um9m4v9mpno2ub1ga.apps.googleusercontent.com

# =============================================================================
# Note: Seamless Backend Switching
# =============================================================================
# To switch backends without code changes:
# 1. Update REACT_APP_API_BASE to your new backend URL
# 2. Ensure backend has FRONTEND_URL set to this Vercel app URL
# 3. Backend automatically allows *.vercel.app, *.azurewebsites.net, *.onrender.com
# 4. Redeploy frontend on Vercel
#
# See BACKEND_SWITCHING_GUIDE.md for detailed instructions
