# React Frontend Environment Variables Template
# Copy this to .env.local for local development or configure in Vercel for production
# All variables must be prefixed with REACT_APP_ to be accessible in React

# =============================================================================
# Backend API Configuration
# =============================================================================
# Backend API URL - Change this to switch between backends seamlessly
# 
# Options:
# - Azure App Service: https://your-app-name.azurewebsites.net
# - Render: https://your-service-name.onrender.com  
# - Local Development: http://localhost:5000
#
# IMPORTANT: No trailing slash!
REACT_APP_API_BASE=http://localhost:5000

# =============================================================================
# Google OAuth Configuration (Optional)
# =============================================================================
# Google OAuth Client ID for "Sign in with Google" feature
# 
# Setup Instructions:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or select existing)
# 3. Enable Google+ API
# 4. Go to Credentials → Create Credentials → OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Add Authorized JavaScript origins:
#    - http://localhost:3000 (for local development)
#    - https://your-app.vercel.app (for production)
# 7. Copy the Client ID and paste below
#
# NOTE: You do NOT need to add redirect URIs (we use implicit flow)
#
# If you don't configure this, users can still authenticate with email/password
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# Mapbox Configuration (Optional)
# =============================================================================
# Mapbox token for map features
# Get from: https://www.mapbox.com/ → Account → Access Tokens
REACT_APP_MAPBOX_TOKEN=your-mapbox-token-here

# =============================================================================
# Additional API Keys (Optional)
# =============================================================================
# Add any other API keys your app needs here
# REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-key
